# Hostinger PostgreSQL connection string (fill in after you create the DB in hPanel)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgresql+psycopg://u123456_s16:change-me@localhost:5432/u123456_s16

# Long random string, e.g. output of: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# First admin account (created by `python -m app.seed`)
ADMIN_EMAIL=admin@s16designstudio.com
ADMIN_PASSWORD=change-me-now

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,https://www.s16designstudio.com

# Public addresses (used for sitemap.xml, canonical links and image URLs)
PUBLIC_SITE_URL=https://www.s16designstudio.com
PUBLIC_API_URL=https://www.s16designstudio.com
# Where uploaded images are stored on the server (keep it outside the code folder in production)
MEDIA_DIR=media
MEDIA_MAX_MB=8
